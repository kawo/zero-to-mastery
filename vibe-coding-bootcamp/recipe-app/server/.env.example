# TheMealDB (v1). Key "1" is TheMealDB's public development key; use your
# supporter key in production. It is only ever read on the server.
MEALDB_API_BASE=https://www.themealdb.com/api/json/v1
MEALDB_API_KEY=1

# Port for the API server. The Vite dev server proxies /api to it.
PORT=3001

# Local full-text search index (SQLite file). Built from TheMealDB on first
# start (a few seconds) and rebuilt when older than SEARCH_REFRESH_HOURS.
SEARCH_DB_PATH=data/recipes.db
SEARCH_REFRESH_HOURS=24

# Comma-separated origins allowed to call the API directly (CORS).
# Not needed when the client reaches the API through a same-origin proxy
# (Vite dev/preview, Netlify redirects, Vercel rewrites).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
