# server/.env.example
#
# Copy this file to server/.env and fill in your token:
#
#   cp server/.env.example server/.env
#
# Get a token by creating a free account at https://www.thenewsapi.com/
# server/.env is git-ignored. Never commit a real token.

THENEWSAPI_TOKEN=your_token_here

# Optional. Port the proxy listens on (the web dev server proxies /api here).
PORT=5177

# Optional. How long a proxied response is reused, in milliseconds.
# The free plan is capped per day, so caching is what keeps it usable.
CACHE_TTL_MS=300000
